# LabelRadar Environment Configuration

# Service Settings
APP_NAME=LabelRadar
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# OpenAI-Compatible LLM Settings
# Swap between local Ollama, vLLM, local MLX, or OpenAI/Anthropic/Groq proxies
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen2.5:latest
# Local MLX model path if running via MLX server:
# /Users/tejaslimaye/.cache/huggingface/hub/models--mlx-community--Qwen3.5-4B-8bit

# Neo4j Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=labelradar_password
NEO4J_DATABASE=neo4j

# Postgres + pgvector Settings
POSTGRES_USER=labelradar
POSTGRES_PASSWORD=labelradar_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=labelradar
DATABASE_URL=postgresql+asyncpg://labelradar:labelradar_password@localhost:5432/labelradar
EMBEDDING_DIM=1536

# openFDA API Settings
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json
OPENFDA_API_KEY=
OPENFDA_TIMEOUT_SECONDS=30.0
